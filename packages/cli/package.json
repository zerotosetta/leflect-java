{
  "name": "@leflect-java/cli",
  "version": "0.1.5",
  "license": "MIT",
  "description": "LeflectJava CLI for Java/JSP static analysis",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "leflect": "dist/index.js"
  },
  "files": [
    "dist",
    "java",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@leflect-java/core": "workspace:*",
    "@leflect-java/graph": "workspace:*",
    "@leflect-java/indexer": "workspace:*",
    "@leflect-java/java-bridge": "workspace:*",
    "@leflect-java/labeler": "workspace:*",
    "@leflect-java/parser-jsp": "workspace:*",
    "@leflect-java/parser-tld": "workspace:*",
    "@leflect-java/reporter": "workspace:*",
    "@leflect-java/scanner": "workspace:*",
    "@leflect-java/schema": "workspace:*",
    "adm-zip": "^0.5.16"
  },
  "publishConfig": {
    "access": "public"
  }
}
