{
  "name": "@lefectjava/cli",
  "version": "0.1.0",
  "description": "LeflectJava CLI for Java/JSP static analysis",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "leflect": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@lefectjava/core": "workspace:*",
    "@lefectjava/graph": "workspace:*",
    "@lefectjava/indexer": "workspace:*",
    "@lefectjava/java-bridge": "workspace:*",
    "@lefectjava/labeler": "workspace:*",
    "@lefectjava/parser-jsp": "workspace:*",
    "@lefectjava/parser-tld": "workspace:*",
    "@lefectjava/reporter": "workspace:*",
    "@lefectjava/scanner": "workspace:*"
  }
}
