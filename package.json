{
  "name": "@leflect-java/workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "bin": {
    "leflect": "bin/leflect"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "example:legacy-java8:fetch": "bash examples/legacy-java8-petclinic/fetch.sh",
    "example:legacy-java8:run": "bash examples/legacy-java8-petclinic/run.sh",
    "npx:build": "pnpm build && node scripts/build-npx-cli.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "release:check": "pnpm typecheck && pnpm test && pnpm build",
    "binary:build": "pnpm build && node scripts/build-binary-package.mjs",
    "binary:test": "node scripts/test-binary-package.mjs",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:publish": "node scripts/release.mjs publish",
    "binary:build:all": "pnpm build && node scripts/build-binary-packages.mjs",
    "binary:test:all": "node scripts/test-binary-packages.mjs",
    "release:prepare:next": "node scripts/release.mjs prepare --tag next",
    "release:publish:next": "node scripts/release.mjs publish --tag next"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "esbuild": "^0.25.1",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0",
    "pkg": "^5.8.1"
  }
}
